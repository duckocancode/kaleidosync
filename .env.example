VITE_DEFAULT_AUTHENTICATED_VIEW=/visualizer
VITE_REOWN_PROJECT_ID=your_reown_project_id_here
VITE_OPENROUTER_API_KEY=your_api_key_here
VITE_S3_BUCKET=https://s3.us-west-1.amazonaws.com/bucket
VITE_SOCKET_URL=http://localhost:2223
# Public origin of this deployment (no trailing slash). Local: http://localhost:3000 with `npx vercel dev`
VITE_API_BASE_URL=http://localhost:3000
VITE_API=http://localhost:3000

# Spotify + Vercel: copy these into .env.vercel (gitignored), paste values, run: npm run vercel:env
# Spotify app: https://developer.spotify.com/dashboard — Redirect URI must match SPOTIFY_REDIRECT_URI exactly
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://YOUR-PROJECT.vercel.app/api/spotify/callback